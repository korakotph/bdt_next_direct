# ══════════════════════════════════════════════════════════════
#  Caddyfile — BDT Next Direct
#
#  โหมด HTTP (IP / localhost) — ไม่มี TLS
#  เข้าถึงได้ที่ http://IP_SERVER/
#
#  ถ้ามี domain ให้เปลี่ยน :80 เป็น your-domain.com
#  Caddy จะออก TLS certificate อัตโนมัติ
#
#  Path routing:
#    http://IP/            → Next.js
#    http://IP/directus/   → Directus CMS + API
# ══════════════════════════════════════════════════════════════

:80 {

    # ── Directus (path: /directus) ─────────────────────────
    handle_path /directus/* {
        reverse_proxy directus:8055
    }

    # ── Next.js (catch-all) ────────────────────────────────
    handle {
        reverse_proxy nextjs:3000
    }

    # ── Logging ────────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
